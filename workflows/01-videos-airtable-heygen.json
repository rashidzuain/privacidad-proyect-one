        1100,
        -300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\n\nconst rows = $input.all().map(item => item.json);\nreturn [{ json: { total: rows.filter(r => r.outcome !== 'empty').length, results: rows.map(r => ({ recordId: r.recordId || null, videoId: r.videoId || null, outcome: r.outcome, message: r.message, notified: r.notified ?? null })) } }];"
      }
    },
    {
      "id": "proyectOneVideos-8",
      "name": "Preparar registro",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        100
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function prepareVideoRecord(record, cfg) {\n  if (record.empty) return { cfg, action: 'skip', outcome: 'empty', message: 'No hay videos pendientes.' };\n  const f = record.fields || {};\n  const ctx = { cfg, recordId: record.id, title: String(f.Titulo || '').trim(), script: String(f.Descripcion || '').trim(), videoId: String(f.HeyGen_VideoID || '').trim(), state: f.Estado, pollAttempt: 0 };\n  if (!/^rec[a-zA-Z0-9]+$/.test(ctx.recordId)) return { ...ctx, action: 'error', outcome: 'invalid', message: 'El identificador de Airtable no es válido.' };\n  if (ctx.videoId) {\n    if (!/^[a-zA-Z0-9_-]+$/.test(ctx.videoId)) return { ...ctx, action: 'error', outcome: 'invalid', message: 'Revisá el identificador de HeyGen.' };\n    return { ...ctx, action: 'poll' };\n  }\n  if (f.Estado === 'En Proceso') return { ...ctx, action: 'error', outcome: 'manual_review', message: 'El registro está En Proceso sin ID de video. Revisá HeyGen antes de cambiarlo a Pendiente.' };\n  if (f.Estado !== 'Pendiente') return { ...ctx, action: 'skip', outcome: 'skipped', message: 'Estado no procesable.' };\n  if (!ctx.title || !ctx.script || ctx.script.length > 10000) return { ...ctx, action: 'error', outcome: 'invalid', message: 'Completá Titulo y Descripcion (hasta 10000 caracteres de guion).' };\n  if (!cfg.generationEnabled) return { ...ctx, action: 'skip', outcome: 'generation_disabled', message: 'La generación está deshabilitada en Configuracion.' };\n  return { ...ctx, action: 'create', requestBody: { fields: { Estado: 'En Proceso' } } };\n}\n\nreturn { json: prepareVideoRecord($json, $(\"Configuracion\").first().json) };"
      }
    },
