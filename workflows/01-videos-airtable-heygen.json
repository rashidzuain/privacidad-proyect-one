                    "name": "offset",
                    "value": "={{ $response.body.offset || undefined }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.offset || $response.statusCode >= 400 }}",
              "limitPagesFetched": true,
              "maxRequests": 1000,
              "requestInterval": 250
            }
          }
